From 406ac9faf7ed0faa79e71ce6931f48ae6c61e8a8 Mon Sep 17 00:00:00 2001
From: reDMP2 <noreply@reexec.local>
Date: Sat, 21 Nov 2026 19:21:40 +0900
Subject: [PATCH] analyze: run .text lui+addiu pointer scan on ET_EXEC images

---
 tools/allegrexrecomp/analyze.c | 12 ++++++------
 tools/allegrexrecomp/analyze.h |  1 +
 tools/allegrexrecomp/main.c    | 14 ++++++++------
 3 files changed, 15 insertions(+), 12 deletions(-)

diff --git a/tools/allegrexrecomp/analyze.c b/tools/allegrexrecomp/analyze.c
index aa0b019..1ffc94f 100644
--- a/tools/allegrexrecomp/analyze.c
+++ b/tools/allegrexrecomp/analyze.c
@@ -533,12 +533,12 @@ int a_discover(a_analysis *an, const uint32_t *seeds, int nseeds) {
      * data table. Any lui whose paired addiu/ori yields an address that is
      * in range and decodes as valid code is promoted to an entry, same
      * over-split-is-safe reasoning as everywhere else in this file. */
-    /* When an->image is present, pointer seeds are already harvested from
-     * relocation tables (or ET_EXEC data scan). Scanning .text for lui+addiu
-     * pairs on an unrelocated PRX (whose lui immediates are 0) produces false
-     * entries at 0x0000xxxx, while on a relocated PRX R_MIPS_HI16/LO16
-     * relocations already enumerate every split-pair code reference. */
-    if (an->scan_calls && !an->image) {
+    /* Skip the .text lui+addiu pair scan on PRX images: an unrelocated PRX
+     * has zero lui immediates that collide with .text, while a relocated PRX
+     * already enumerates every split-pair code reference through HI16/LO16
+     * relocations. Fixed-address ET_EXEC images have no relocation tables,
+     * so they need this scan to find code-built function pointers. */
+    if (an->scan_calls && !an->skip_lui_scan) {
         uint32_t sbase = an->scan_size ? an->scan_base : an->base;
         uint32_t ssize = an->scan_size ? an->scan_size : an->size;
         for (uint32_t off = 0; off + 4 <= ssize; off += 4) {
diff --git a/tools/allegrexrecomp/analyze.h b/tools/allegrexrecomp/analyze.h
index 041c130..fddf2e0 100644
--- a/tools/allegrexrecomp/analyze.h
+++ b/tools/allegrexrecomp/analyze.h
@@ -88,6 +88,7 @@ typedef struct {
     const uint8_t *image;
     uint32_t       image_base;
     uint32_t       image_size;
+    int            skip_lui_scan;   /* 1 for PRX images (relocs or base 0) */
 
     /* Output */
     a_func   *funcs;
diff --git a/tools/allegrexrecomp/main.c b/tools/allegrexrecomp/main.c
index d988e31..f62c15d 100644
--- a/tools/allegrexrecomp/main.c
+++ b/tools/allegrexrecomp/main.c
@@ -524,13 +524,15 @@ static int load_and_discover(const char *path, uint32_t base, uint8_t **out_relo
     an->scan_calls = 1;
     /* The whole loaded segment, so jump tables in .rodata/.data can be read. */
     if (reloc_buf) {
-        an->image      = reloc_buf;
-        an->image_base = base;
-        an->image_size = (uint32_t)reloc_sz;
+        an->image         = reloc_buf;
+        an->image_base    = base;
+        an->image_size    = (uint32_t)reloc_sz;
+        an->skip_lui_scan = 1;
     } else if (e->nsegments) {
-        an->image      = b->data + e->seg[0].offset;
-        an->image_base = e->seg[0].addr;
-        an->image_size = e->seg[0].filesz;
+        an->image         = b->data + e->seg[0].offset;
+        an->image_base    = e->seg[0].addr;
+        an->image_size    = e->seg[0].filesz;
+        an->skip_lui_scan = (e->type != 2);
     }
 
     /* Seeds come from three places, in increasing order of how much they find:
