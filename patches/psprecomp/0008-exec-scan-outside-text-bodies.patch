From eeb56370dcbd005bb5be3262399e7aae12da824c Mon Sep 17 00:00:00 2001
From: reDMP2 <noreply@reexec.local>
Date: Sat, 21 Nov 2026 19:21:40 +0900
Subject: [PATCH] analyze: scan discovered non-.text function bodies for
 lui+addiu pointers

---
 tools/allegrexrecomp/analyze.c | 39 +++++++++++++++++++++++++++++++++-
 1 file changed, 38 insertions(+), 1 deletion(-)

diff --git a/tools/allegrexrecomp/analyze.c b/tools/allegrexrecomp/analyze.c
index 1ffc94f..8b50a14 100644
--- a/tools/allegrexrecomp/analyze.c
+++ b/tools/allegrexrecomp/analyze.c
@@ -594,13 +594,50 @@ int a_discover(a_analysis *an, const uint32_t *seeds, int nseeds) {
  * converges in a handful of rounds. */
     for (int round = 0; round < 8; round++) {
     if (round > 0) {
-        if (!an->image && !cross.n && !indirects.n) break;
+        if (!an->image && !cross.n && !indirects.n &&
+            !(an->scan_calls && !an->skip_lui_scan)) break;
         u32list targets = { 0 };
         for (int i = 0; i < indirects.n; i++) {
             int n = resolve_jump_table(an, indirects.v[i], &targets);
             if (n > 0) { an->ntables++; an->ntable_targets += n; }
         }
         for (int i = 0; i < cross.n; i++) u32_push(&targets, cross.v[i]);
+        /* Also scan body instructions of discovered functions lying outside
+         * .text (e.g. C++ static initializers in .data) for lui+addiu/ori
+         * pairs targeting .text, without scanning raw .data linearly. */
+        if (an->scan_calls && !an->skip_lui_scan && an->scan_size) {
+            uint32_t sbase = an->scan_base;
+            uint32_t ssize = an->scan_size;
+            for (uint32_t i = 0; i < nwords; i++) {
+                if (owner[i] == A_NO_OWNER) continue;
+                uint32_t a = an->base + i * 4;
+                if (a - sbase < ssize) continue;
+                a_insn in;
+                a_decode(fetch(an, a), a, &in);
+                if (in.op != A_LUI) continue;
+
+                for (int k = 1; k <= 4; k++) {
+                    uint32_t b = a + (uint32_t)k * 4;
+                    if (!a_in_range(an, b)) break;
+                    if (owner[word_index(an, b)] != owner[i]) break;
+                    a_insn in2;
+                    a_decode(fetch(an, b), b, &in2);
+                    if (in2.op == A_LUI && in2.rt == in.rt) break;
+                    if ((in2.op == A_ADDIU || in2.op == A_ORI) && in2.rs == in.rt) {
+                        uint32_t addr = (in2.op == A_ORI)
+                            ? (((uint32_t)in.imm << 16) | (uint32_t)in2.imm)
+                            : (((uint32_t)in.imm << 16) + (uint32_t)in2.imm);
+                        if (a_in_range(an, addr) && !is_import_stub(an, addr) &&
+                            addr - sbase < ssize) {
+                            a_insn probe;
+                            if (a_decode(fetch(an, addr), addr, &probe) && probe.op != A_INVALID)
+                                u32_push(&targets, addr);
+                        }
+                        break;
+                    }
+                }
+            }
+        }
         cross.n = 0;
         indirects.n = 0;
         int added = 0;
-- 
